
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "djibabouya-foot-tv",
  "main": "worker.js",
  "compatibility_date": "2026-09-09",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "djibabouya-foot-tv",
      "database_id": "6c2e69f5-01e5-472d-8b8a-7071b436096f"
    }
  ]
}
